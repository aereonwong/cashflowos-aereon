  "components": [
    {
      "name": "Primary Button (Contact Sheet)",
      "kind": "button",
      "refersTo": "button-primary-contact",
      "description": "Print-white fill on film black; the main action in Contact Sheet.",
      "html": "<button class=\"ds-btn-contact\">Open invoices</button>",
      "css": ".ds-btn-contact{font-family:Barlow,system-ui,sans-serif;font-size:.8125rem;font-weight:500;background:#EDEAE3;color:#0D0D0D;border:1px solid #EDEAE3;border-radius:2px;padding:6px 11px;cursor:pointer;transition:background 200ms cubic-bezier(.16,1,.3,1)}.ds-btn-contact:hover{background:color-mix(in srgb,#EDEAE3 86%,#0D0D0D)}.ds-btn-contact:focus-visible{outline:2px solid #E4322B;outline-offset:2px}"
    },
    {
      "name": "Primary Button (Studio Standard)",
      "kind": "button",
      "refersTo": "button-primary-canon",
      "description": "The one indigo action.",
      "html": "<button class=\"ds-btn-canon\">Book a collaboration</button>",
      "css": ".ds-btn-canon{font-family:Geist,system-ui,sans-serif;font-size:.8125rem;font-weight:500;background:#5B5BD6;color:#fff;border:1px solid #5B5BD6;border-radius:10px;padding:6px 11px;cursor:pointer;transition:background 200ms cubic-bezier(.16,1,.3,1)}.ds-btn-canon:hover{background:color-mix(in srgb,#5B5BD6 86%,#F7F7F8)}.ds-btn-canon:focus-visible{outline:2px solid #5B5BD6;outline-offset:2px}"
    },
    {
      "name": "Segmented Filter (Flight HUD)",
      "kind": "chip",
      "refersTo": "segment-pressed-hud",
      "description": "Date-range segment; the pressed option is underlined in HUD white.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"false\">This year</button><button aria-pressed=\"true\">12 months</button><button aria-pressed=\"false\">All time</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:2px;background:#0D1117;font-family:'Chakra Petch',system-ui,sans-serif}.ds-seg button{font:inherit;font-size:.8125rem;font-weight:500;border:0;background:transparent;color:rgba(244,247,250,.72);padding:6px 11px;border-radius:0;cursor:pointer;transition:color 200ms,box-shadow 200ms}.ds-seg button:hover{color:#F4F7FA}.ds-seg button[aria-pressed=true]{color:#F4F7FA;box-shadow:inset 0 -2px 0 #F4F7FA}.ds-seg button:focus-visible{outline:2px solid #F4F7FA;outline-offset:2px}"
    },
    {
      "name": "Film-Strip Panel (Contact Sheet)",
      "kind": "card",
      "refersTo": "panel-contact",
      "description": "A panel as a strip of film: sprocket rebates top and bottom, edge code in the rebate.",
      "html": "<section class=\"ds-film\"><span class=\"ds-edge\">INV-2026-041 · INV-2026-042</span><h3>Who owes me</h3><p>RM 12,400 across 3 invoices</p></section>",
      "css": ".ds-film{position:relative;background:#161616;color:#EDEAE3;padding:38px 24px;border-radius:2px;font-family:Barlow,system-ui,sans-serif;font-size:.9375rem}.ds-film::before,.ds-film::after{content:'';position:absolute;left:10px;right:10px;height:7px;background:repeating-linear-gradient(90deg,rgba(13,13,13,.95) 0 9px,transparent 9px 17px);opacity:.9}.ds-film::before{top:6px}.ds-film::after{bottom:6px}.ds-film h3{margin:0 0 8px;font-family:'Barlow Condensed',Barlow,sans-serif;font-weight:700;font-size:1.125rem;text-transform:uppercase;letter-spacing:.03em}.ds-film p{margin:0;color:#B4B0A6;font-variant-numeric:tabular-nums}.ds-edge{position:absolute;right:18px;top:14px;font-family:'Share Tech Mono',monospace;font-size:10.5px;letter-spacing:.08em;color:#F2B544}"
    },
    {
      "name": "Instrument Panel (Flight HUD)",
      "kind": "card",
      "refersTo": "panel-hud",
      "description": "A scrim over the feed marked by two corner brackets.",
      "html": "<section class=\"ds-inst\"><h3>Battery · owed</h3><div class=\"ds-val\">RM 12,400</div><div class=\"ds-batt\" data-level=\"warn\"><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i></i><i></i></div></section>",
      "css": ".ds-inst{position:relative;background:rgba(5,8,13,.55);backdrop-filter:blur(6px);color:#F4F7FA;padding:24px;font-family:'Chakra Petch',system-ui,sans-serif}.ds-inst::before,.ds-inst::after{content:'';position:absolute;width:18px;height:18px;border:0 solid #F4F7FA}.ds-inst::before{top:0;left:0;border-top-width:2px;border-left-width:2px}.ds-inst::after{bottom:0;right:0;border-bottom-width:2px;border-right-width:2px}.ds-inst h3{margin:0 0 12px;font-size:.8125rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(244,247,250,.72)}.ds-val{font-weight:700;font-size:1.375rem;font-variant-numeric:tabular-nums;margin:4px 0}.ds-batt{display:flex;gap:3px;height:14px}.ds-batt i{flex:1;background:rgba(244,247,250,.22)}.ds-batt[data-level=warn] i.on{background:#FFD60A}"
    },
    {
      "name": "KPI Card (Studio Standard)",
      "kind": "card",
      "refersTo": "kpi-canon",
      "description": "One of four KPIs; value in Geist Mono with a delta pill.",
      "html": "<a class=\"ds-kpi\" href=\"#\"><div class=\"ds-kl\">Income this year</div><div class=\"ds-kv\">RM 184,200 <span class=\"ds-delta\">+12%</span></div><div class=\"ds-kn\">vs same point last year</div></a>",
      "css": ".ds-kpi{display:block;text-decoration:none;color:#0A0A0B;background:#fff;border:1px solid #E4E4E7;border-radius:10px;padding:16px 24px;font-family:Geist,system-ui,sans-serif;transition:border-color 200ms cubic-bezier(.16,1,.3,1)}.ds-kpi:hover{border-color:#D4D4D8}.ds-kpi:focus-visible{outline:2px solid #5B5BD6;outline-offset:2px}.ds-kl{font-size:.8125rem;color:#52525B}.ds-kv{font-family:'Geist Mono',ui-monospace,monospace;font-size:1.625rem;font-weight:600;letter-spacing:-.02em;margin:8px 0 4px;font-variant-numeric:tabular-nums;display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 8px}.ds-delta{font-size:.75rem;font-weight:600;padding:1px 6px;border-radius:99px;color:#15803D;background:color-mix(in srgb,#15803D 12%,transparent)}.ds-kn{font-size:.75rem;color:#71717A}"
    },
    {
      "name": "Month Frame with Grease-Pencil Circle (Contact Sheet)",
      "kind": "custom",
      "refersTo": "month-frame-contact",
      "description": "A month printed at one shared scale; density is value; the keeper is circled; the loupe lifts it on hover.",
      "html": "<button class=\"ds-cell\"><svg class=\"ds-circle\" viewBox=\"0 0 120 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><path d=\"M62 6 C 26 4, 6 22, 7 50 C 8 80, 34 95, 64 94 C 96 93, 115 74, 113 47 C 111 21, 88 5, 58 8 C 45 9, 36 13, 30 18\"/></svg><span class=\"m\">AUG</span><span class=\"v\">RM 31.2k</span></button>",
      "css": ".ds-cell{position:relative;width:96px;aspect-ratio:3/4;display:flex;flex-direction:column;justify-content:flex-end;gap:2px;padding:8px;border:0;cursor:pointer;text-align:left;font-family:Barlow,system-ui,sans-serif;background:rgba(237,234,227,.82);box-shadow:inset 0 0 0 3px #EDEAE3;color:#0D0D0D;transition:transform 260ms cubic-bezier(.16,1,.3,1),box-shadow 260ms cubic-bezier(.16,1,.3,1)}.ds-cell .m{font-size:.75rem;font-weight:600}.ds-cell .v{font-size:.8125rem;font-weight:700;font-variant-numeric:tabular-nums}.ds-cell:hover,.ds-cell:focus-visible{transform:scale(1.18) translateY(-6px);z-index:3;box-shadow:inset 0 0 0 3px #EDEAE3,0 22px 40px -12px rgba(0,0,0,.9),0 0 0 1px rgba(0,0,0,.8);outline:none}.ds-circle{position:absolute;left:10%;top:7%;width:80%;height:48%;overflow:visible;pointer-events:none}.ds-circle path{fill:none;stroke:#E4322B;stroke-width:3.2;stroke-linecap:round;stroke-dasharray:600;stroke-dashoffset:600;animation:ds-draw 900ms cubic-bezier(.16,1,.3,1) 200ms forwards}@keyframes ds-draw{to{stroke-dashoffset:0}}@media (prefers-reduced-motion:reduce){.ds-circle path{animation:none;stroke-dashoffset:0}.ds-cell{transition:none}}"
    },
    {
      "name": "Rail Navigation (Studio Standard)",
      "kind": "nav",
      "refersTo": "nav-item-active-canon",
      "description": "Grouped rail links with stroked icons; current item in indigo on soft indigo.",
